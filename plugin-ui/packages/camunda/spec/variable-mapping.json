        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "profile": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string"
              }
            },
            "required": ["displayName"]
          }
        },
        "required": ["firstName", "active", "profile"],
        "additionalProperties": false
      },
      "data": {
        "firstName": "Alex",
        "active": false,
        "profile": {
          "displayName": "A"
        }
      },
      "variables": {
        "firstName": {
          "type": "String",
          "value": "Alex",
          "valueInfo": {}
        },
        "active": {
          "type": "Boolean",
          "value": false,
          "valueInfo": {}
        },
        "profile": {
          "type": "Json",
          "value": "{\"displayName\":\"A\"}",
          "valueInfo": {}
        }
      }
